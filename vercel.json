{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/events/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/e/:slug",
      "destination": "/event"
    }
  ],
  "redirects": [
    {
      "source": "/e/mizutani-kagakukan-2026",
      "destination": "/",
      "permanent": false
    }
  ]
}